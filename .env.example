# Copy to .env for Docker Compose. For Coolify, enter these as Environment Variables.
# Hostname only (without https:// or a path). Use a separate staging hostname first.
DASHBOARD_HOST=threads-staging.example.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_CLOUDFLARE_ACCESS_AUD
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
THREADS_ACCESS_TOKEN=REPLACE_WITH_THREADS_LONG_LIVED_TOKEN
SECRET_API_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET
DB_PATH=/app/data/secretary.db
# Explicit safety lock: do not enable until live publishing is intended.
THREADS_PUBLISH_ENABLED=false
